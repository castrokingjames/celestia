# ─────────────────────────────────────────────────────────────────────────────
# Celestia server env — SECRETS + per-env values. Copy to `.env` (gitignored) and
# fill real values. Non-secret config lives in config/default.json; this file is
# ONLY for secrets + things that differ per environment. Never commit a real .env.
# ─────────────────────────────────────────────────────────────────────────────

NODE_ENV=development

# ── Datastores (config/default.json → datastores.*Env resolve to these) ──────
# Dev defaults match docker-compose.gaia.yml (user/pass/db = celestia).
# DATABASE_URL is the ADMIN/owner connection: migrations (incl. creating the per-service roles), role
# management, and the server-local grant CLI all use it.
DATABASE_URL=postgres://celestia:celestia@localhost:5432/celestia
VALKEY_URL=redis://localhost:6379

# ── Per-service DB roles (write-ownership enforcement — docs/REFACTOR.md S1 move 6) ──────────────────
# Each service connects as its OWN least-privilege role: Polaris RW on identity/auth, Atlas RW on game data
# with NO WRITE on auth tables. Leave the two URLs UNSET to use DATABASE_URL for everything (simple dev, no
# enforcement). To ACTIVATE: set *_DB_PASSWORD, run `pnpm --filter @celestia/polaris migrate` (as DATABASE_URL)
# to create + grant + password the roles, then point the URLs at them. The password in each URL must match the
# matching *_DB_PASSWORD. (Prod: set these from a secrets manager, not here.)
POLARIS_DATABASE_URL=postgres://polaris_app:change-me-polaris@localhost:5432/celestia
ATLAS_DATABASE_URL=postgres://atlas_app:change-me-atlas@localhost:5432/celestia
POLARIS_DB_PASSWORD=change-me-polaris
ATLAS_DB_PASSWORD=change-me-atlas

# ── Auth · JWT signing (EdDSA / Ed25519) ─────────────────────────────────────
# base64-encoded PEM (single line — avoids multi-line env parsing). Generate into .env with:
#   pnpm --filter @celestia/polaris gen-dev-keys
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ── Auth · refresh tokens (opaque, rotating, hashed at rest) ─────────────────
AUTH_TOKEN_PEPPER=change-me-dev-pepper

# ── Auth · basic method (gates POST /auth/basic so sessions can't be freely minted; grants NO role)
BASIC_AUTH_SECRET=change-me-dev

# ── Auth · Discord OAuth (only needed when config auth.discord.enabled = true) ─
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_REDIRECT_URI=http://localhost:3000/auth/discord/callback

# ── Polaris · CORS — extra allowed browser origins for DEPLOYED client(s), comma-separated. Merged with the
# dev defaults (localhost) in config/default.json, so adding a client URL in prod is an env change + restart,
# never a code edit. e.g. POLARIS_CORS_ORIGINS=https://phaethon-5a03.onrender.com,https://celestia-flaa.onrender.com
POLARIS_CORS_ORIGINS=

# ── Later (flags off for now) ────────────────────────────────────────────────
# ANTHROPIC_API_KEY=            # when flags.llm = true
