{
  "_comment": "Non-secret SERVER config (dev defaults). SECRETS (JWT keys, DB/Redis creds, Discord secret) come from env — see datastores.*Env + .env, never inline here. Shared values the client also needs (e.g. MOVE_SPEED, intent types) live in packages/norma. Game-balance DATA (combat/mobs/loot) lives with the GameModule. Later: a zod-validated loader (@celestia/config) + per-env overrides (dev/staging/prod) that merge env secrets on top.",

  "env": "dev",

  "realtime": {
    "port": 2567,
    "tickHz": 20,
    "patchRateHz": 20,
    "maxClientsPerChannel": 1000,
    "publicUrl": "ws://localhost:2567",
    "autosaveIntervalSec": 15,
    "revocationSweepSec": 10
  },

  "polaris": {
    "port": 3000,
    "corsOrigins": ["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:5174", "http://127.0.0.1:5174", "https://celestia-flaa.onrender.com", "https://phaethon-5a03.onrender.com"]
  },

  "auth": {
    "enabledMethods": ["basic"],
    "accessTokenTtlSec": 900,
    "refreshTokenTtlSec": 2592000,
    "accessTicketTtlSec": 30,
    "discord": { "enabled": false, "guildId": "" }
  },

  "game": {
    "maxCharactersPerAccount": 5,
    "startingZoneId": "genesis"
  },

  "datastores": {
    "postgresUrlEnv": "DATABASE_URL",
    "polarisPostgresUrlEnv": "POLARIS_DATABASE_URL",
    "atlasPostgresUrlEnv": "ATLAS_DATABASE_URL",
    "valkeyUrlEnv": "VALKEY_URL"
  },

  "limits": {
    "intentRatePerSec": 30,
    "reconnectGraceSec": 60
  },

  "flags": {
    "llm": false,
    "web3": false,
    "maintenance": false
  }
}
