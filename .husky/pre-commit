#!/usr/bin/env sh
# Celestia pre-commit — fast, instant checks only (type-safety runs on pre-push). No pnpm needed here.

# Context-sync gate: if a .context/ rule changed but the generated Copilot summary wasn't
# re-generated, it's stale. Block and point to the sync skill (convention AB12).
if git diff --cached --name-only | grep -q '^\.context/' \
   && ! git diff --cached --name-only | grep -q '^\.github/copilot-instructions\.md$'; then
  echo "✖ .context/ changed but .github/copilot-instructions.md was not re-generated."
  echo "  Run the 'sync-copilot-instructions' skill, then re-stage .github/copilot-instructions.md."
  exit 1
fi
