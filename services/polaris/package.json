{
  "name": "@celestia/polaris",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file=../../.env --watch --import tsx src/main.ts",
    "prestart": "tsx src/db/migrate.ts",
    "start": "tsx src/main.ts",
    "db:init": "node --env-file-if-exists=../../.env --import tsx scripts/db-init.ts",
    "migrate": "node --env-file=../../.env --import tsx src/db/migrate.ts",
    "gen-dev-keys": "node --import tsx scripts/gen-dev-keys.ts",
    "grant": "node --env-file=../../.env --import tsx scripts/grant.ts",
    "ban": "node --env-file=../../.env --import tsx scripts/ban.ts",
    "test": "node --env-file=../../.env --import tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@celestia/norma": "workspace:*",
    "@celestia/firmament": "workspace:*",
    "@celestia/argus": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "jose": "^5.9.0",
    "kysely": "^0.27.4",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "tsx": "^4.19.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.7.0"
  }
}
